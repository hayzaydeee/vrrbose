{
  "name": "@vrrbose/daemon",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc && node -e \"require('fs').cpSync('src/db/schema.sql','dist/db/schema.sql')\"",
    "dev": "nodemon --watch src --ext ts,json --delay 1 --exec \"tsx --env-file=.env src/index.ts\"",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "verify:sync-gates": "tsx src/scripts/sync-gate-check.ts",
    "verify:capture-gates": "tsx src/scripts/capture-gate-check.ts",
    "verify:session-metrics-gates": "tsx src/scripts/session-metrics-gate-check.ts",
    "verify:migration-gates": "tsx src/scripts/migration-gate-check.ts",
    "verify:file-summary-gates": "tsx src/scripts/file-summary-gate-check.ts",
    "verify:capsule-trigger-gates": "tsx src/scripts/capsule-trigger-gate-check.ts",
    "verify:document-gen-gates": "tsx src/scripts/document-gen-gate-check.ts",
    "verify:provider-fallback-gates": "tsx src/scripts/provider-fallback-gate-check.ts",
    "verify:response-contract-gates": "tsx src/scripts/response-contract-gate-check.ts",
    "verify:web-contract-gates": "tsx src/scripts/web-contract-gate-check.ts",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.20.0",
    "@vrrbose/shared": "workspace:*",
    "better-sqlite3": "^11.10.0",
    "chokidar": "^3.6.0",
    "cors": "^2.8.5",
    "express": "^4.18.0",
    "simple-git": "^3.33.0",
    "socket.io": "^4.7.0",
    "uuid": "^9.0.0",
    "yaml": "^2.4.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.0",
    "@types/cors": "^2.8.0",
    "@types/express": "^4.17.0",
    "@types/node": "^20.0.0",
    "@types/uuid": "^9.0.0",
    "nodemon": "^3.1.14",
    "rimraf": "^5.0.0",
    "tsx": "^4.7.0",
    "typescript": "^5.4.0"
  }
}
